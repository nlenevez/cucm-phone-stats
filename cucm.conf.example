; cucm-phone-stats configuration. Copy to cucm.conf and edit.
; Looked up in ./cucm.conf, <repo>/cucm.conf, ~/.cucm-phone-stats.conf, or --config FILE.
; Any key can be overridden as CPS_<UPPERCASE_KEY> in the environment; CLI flags win over both.

; ---------------------------------------------------------------- CUCM ----
; CUCM nodes to query, comma or space separated; bare hostnames get https:// and cucm_port.
cucm_servers   = cucm-sub1.example.local, cucm-sub2.example.local
cucm_port      = 8443

; Application user with Standard AXL API Access (see docs/cucm-permissions.md).
axl_user       = axluser
; Password inline, from a file, or from a named environment variable.
axl_pass       =
axl_pass_file  =
axl_pass_env   =
; AXL schema version; blank negotiates (15.0 down to 10.0).
axl_version    =

; Record each phone's Common Phone Profile every sweep (1/0).
collect_phone_profiles = 1

; Verify CUCM's TLS certificate (1/0) against this CA bundle.
verify_tls     = 0
ca_bundle      =

; SOAP request timeout, seconds.
soap_timeout   = 60
; RisPort requests per minute (sliding window); keep below the cluster limit (often 15).
ris_rate_per_min = 12
; Retries after a RisPort rate-limit fault.
ris_rate_retries = 4
; Extra minimum gap between RisPort calls, ms.
ris_gap_ms     = 0
; Devices asked for per RisPort query (RisPort maximum 1000).
ris_max_devices = 1000
; auto = re-query each node if the answer is at the cap; always = always per node; off = one query.
ris_partitions = auto

; --------------------------------------------------------------- phones ---
; Phone web base URL; {ip} is replaced with the phone's address.
phone_url_base = https://{ip}
; Phone web credentials, only for Web Access = Authenticated.
phone_user     =
phone_pass     =
phone_pass_file =
phone_pass_env  =

; Device-name prefixes to poll (SEP = desk phones); blank = all; --all-devices overrides.
poll_device_prefixes = SEP

; CIDRs never polled, comma separated, e.g. 10.20.0.0/16, 10.30.4.0/24.
exclude_subnets =

; Schemes cucm-probe.php tries on a phone; does not affect sweeps.
phone_probe_schemes = https,http

; Phones polled at once.
phone_parallel = 10
; Per-request and connect timeouts, seconds.
phone_timeout  = 10
phone_connect_timeout = 5

; Phone pages to fetch; config carries CDP/LLDP for the switch comparison.
adapters       = network,access,ethernet,device,config

; ------------------------------------------------------------- database ---
; Store results in MySQL (1/0).
db_enabled     = 1
; localhost uses the UNIX socket (db_port ignored); an IP uses TCP.
db_host        = localhost
db_port        = 3306
db_name        = cucm_phone_stats
; Runtime account: SELECT, INSERT, UPDATE.
db_user        = cucm
db_pass        =
db_pass_file   =
db_pass_env    =
